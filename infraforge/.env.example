# InfraForge v1 — Environment Configuration
# Copy to .env and fill in all values before running.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── Application ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_64_char_hex_secret

# ── Internal service API keys ─────────────────────────────────────────────────
# The platform API uses these to authenticate calls to internal services.
# Generate independently: python -c "import secrets; print(secrets.token_hex(32))"
ORCHESTRATOR_API_KEY=change_me_orchestrator_key
GRADER_API_KEY=change_me_grader_key

# ── Object storage (MinIO for local, S3 for prod) ────────────────────────────
MINIO_ROOT_USER=infraforge
MINIO_ROOT_PASSWORD=change_me_minio_password

# ── Billing ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Auth ──────────────────────────────────────────────────────────────────────
# For Clerk (production) or leave empty for local JWT auth
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change_me_grafana_password

# ── Email (for notifications) ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@infraforge.io
SMTP_PASSWORD=change_me_smtp_password

# ── Feature flags ─────────────────────────────────────────────────────────────
# vm_labs: enables VM-based labs (requires nested virt or bare metal workers)
FEATURE_VM_LABS=false
FEATURE_TEAM_LABS=false
FEATURE_PUBLIC_PORTFOLIO=true
